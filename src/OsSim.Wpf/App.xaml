<Application x:Class="OsSim.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:OsSim.Wpf.ViewModels"
             xmlns:animations="clr-namespace:OsSim.Wpf.Animations">
    <Application.Resources>
        <Color x:Key="CanvasColor">#F5F6FC</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="SurfaceSoftColor">#F0F1FB</Color>
        <Color x:Key="PrimaryColor">#4035C8</Color>
        <Color x:Key="PrimaryContainerColor">#5148D8</Color>
        <Color x:Key="NavigationBadgeColor">#E6E4FF</Color>
        <Color x:Key="PrimarySoftColor">#EFEEFF</Color>
        <Color x:Key="SuccessSoftColor">#E8F5EF</Color>
        <Color x:Key="WarningSoftColor">#FFF3E7</Color>
        <Color x:Key="DangerSoftColor">#FCEEEF</Color>
        <Color x:Key="AccentColor">#006C4A</Color>
        <Color x:Key="TextColor">#171B2D</Color>
        <Color x:Key="MutedColor">#5D6277</Color>
        <Color x:Key="BorderColor">#DADDEF</Color>
        <Color x:Key="SuccessColor">#087A55</Color>
        <Color x:Key="WarningColor">#A85A12</Color>
        <Color x:Key="DangerColor">#B43B45</Color>

        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
        <SolidColorBrush x:Key="NavigationBadgeBrush" Color="{StaticResource NavigationBadgeColor}" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavigationBadgeBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:MetricCardVisual}">
            <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    Padding="11,9" Margin="3">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Success}">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Warning}">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Danger}">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,1">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Success}">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Warning}">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Danger}">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SimulationActionVisual}">
            <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    Padding="12,10" Margin="3" AutomationProperties.Name="{Binding Title}"
                    RenderTransformOrigin="0.5,0.5"
                    animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Success}">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Warning}">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static viewModels:MetricTone.Danger}">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                            Padding="9,6" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StepLabel}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding Explanation}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:BankerRagGraphVisual}">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Margin="3,0,3,5" />
                <WrapPanel Margin="3,0,3,7">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource PrimarySoftBrush}"
                                 Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1" />
                        <TextBlock Text="Tiến trình" FontSize="10" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                        <Rectangle Width="12" Height="12" Fill="{StaticResource SuccessSoftBrush}"
                                   Stroke="{StaticResource SuccessBrush}" StrokeThickness="1" />
                        <TextBlock Text="Tài nguyên · Work / tổng" FontSize="10" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                        <Canvas Width="25" Height="12">
                            <Line X1="1" Y1="6" X2="23" Y2="6" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" />
                            <Polygon Points="23,6 17,2 17,10" Fill="{StaticResource SuccessBrush}" />
                        </Canvas>
                        <TextBlock Text="Allocation · R → P" FontSize="10" Margin="3,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                        <Canvas Width="25" Height="12">
                            <Line X1="1" Y1="6" X2="23" Y2="6" Stroke="{StaticResource WarningBrush}"
                                  StrokeThickness="2" StrokeDashArray="3,2" />
                            <Polygon Points="23,6 17,2 17,10" Fill="{StaticResource WarningBrush}" />
                        </Canvas>
                        <TextBlock Text="Need / claim · P → R" FontSize="10" Margin="3,0,0,0" />
                    </StackPanel>
                </WrapPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              MaxHeight="410">
                    <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                        <ItemsControl ItemsSource="{Binding Edges}" Width="{Binding CanvasWidth}"
                                      Height="{Binding CanvasHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                        <Line X1="{Binding StartX}" Y1="{Binding StartY}"
                                              X2="{Binding EndX}" Y2="{Binding EndY}" StrokeThickness="2"
                                              ToolTip="{Binding Details}">
                                            <Line.Style>
                                                <Style TargetType="{x:Type Line}">
                                                    <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAllocation}" Value="False">
                                                            <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
                                                            <Setter Property="StrokeDashArray" Value="4,3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Line.Style>
                                        </Line>
                                        <Polygon Points="{Binding ArrowPoints}" ToolTip="{Binding Details}">
                                            <Polygon.Style>
                                                <Style TargetType="{x:Type Polygon}">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAllocation}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Polygon.Style>
                                        </Polygon>
                                        <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1" CornerRadius="4" Padding="3,1" ToolTip="{Binding Details}">
                                            <TextBlock Text="{Binding EdgeLabel}" FontSize="9" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllocation}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Nodes}" Width="{Binding CanvasWidth}"
                                      Height="{Binding CanvasHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                        <Border Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                                Width="{Binding Width}" Height="{Binding Height}"
                                                BorderThickness="1.5"
                                                ToolTip="{Binding Details}" RenderTransformOrigin="0.5,0.5"
                                                animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="CornerRadius" Value="32" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResource}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                            <Setter Property="CornerRadius" Value="8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SubLabel}" FontSize="8.5"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header" Margin="0,0,0,7"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource TextBrush}" />
                                <ContentPresenter Grid.Row="1" ContentSource="Content" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="RowHeight" Value="28" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="SurfaceCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </Application.Resources>
</Application>

