<UserControl x:Class="OsSim.Wpf.Views.CpuSchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OsSim.Wpf.Views"
             xmlns:animations="clr-namespace:OsSim.Wpf.Animations">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,2,4,5">
                <TextBlock Text="Lập lịch CPU" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Theo dõi tiến trình đang chạy, hàng đợi và biểu đồ Gantt."
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Expander Grid.Row="1" Header="Thiết lập kịch bản" IsExpanded="False" Margin="3">
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.75*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Danh sách tiến trình" FontWeight="SemiBold" />
                            <TextBlock Text="Mã, thời điểm đến, CPU burst, độ ưu tiên"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,4" />
                            <TextBox Text="{Binding ProcessInput, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="76" MaxHeight="104"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Thuật toán" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <ComboBox ItemsSource="{Binding Algorithms}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedAlgorithm}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Quantum (Round Robin)" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding TimeQuantum, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Overhead chuyển ngữ cảnh" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding ContextSwitchOverhead, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Tạo mô phỏng" Command="{Binding CreateSimulationCommand}"
                                    VerticalAlignment="Bottom" Margin="8,4,4,4" />
                        </Grid>
                    </Grid>
                </Border>
            </Expander>

            <views:PlaybackControls Grid.Row="2" DataContext="{Binding Playback}" />

            <StackPanel Grid.Row="3">
                <ContentControl Content="{Binding CurrentAction}" />
                <Expander Header="Số liệu tổng hợp" IsExpanded="False" Margin="3,0,3,5">
                    <ItemsControl ItemsSource="{Binding MetricCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <Border Grid.Row="4" Style="{StaticResource SurfaceCardStyle}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimaryBrush}"
                            RenderTransformOrigin="0.5,0.5"
                            animations:PulseAnimation.PulseVersion="{Binding CpuPulseVersion}">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <TextBlock Text="CPU" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="Lõi xử lý" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding RunningProcessStatus}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="READY QUEUE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ReadyQueueStatus}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ReadyQueue}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="7"
                                            Padding="8,4" Margin="2">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <DockPanel Margin="4,0,4,7" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Trạng thái tiến trình" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="Đã dùng / tổng CPU burst"
                                   Foreground="{StaticResource MutedBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ProcessStates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="166" Padding="8" Margin="3" CornerRadius="9"
                                        RenderTransformOrigin="0.5,0.5"
                                        animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="#E8F4F7" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" />
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding StateLabel}"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     animations:ProgressValueAnimation.TargetValue="{Binding ProgressPercent}"
                                                     Height="7" Margin="0,7,0,5" />
                                        <TextBlock Text="{Binding RemainingLabel}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="6" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Biểu đồ Gantt" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{Binding GanttCaption}" Foreground="{StaticResource MutedBrush}" Margin="4,0,4,8" />
                        <ItemsControl ItemsSource="{Binding GanttSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DataTemplate.Resources>
                                        <Style x:Key="GanttLabelStyle" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsContextSwitch}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataTemplate.Resources>
                                    <Border Width="{Binding Width}" Padding="8,6" Margin="3" CornerRadius="7"
                                            RenderTransformOrigin="0.5,0.5"
                                            animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                                        <Setter Property="Background" Value="#E8EDF2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsContextSwitch}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource GanttLabelStyle}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Start, StringFormat={}{0:0.##}}" Style="{StaticResource GanttLabelStyle}"
                                                       FontSize="11" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding End, StringFormat={}{0:0.##}}" Style="{StaticResource GanttLabelStyle}"
                                                       FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding MetricsText}" FontWeight="SemiBold" Margin="10,8" />
                    <Expander Grid.Row="1" Header="Số liệu theo tiến trình" IsExpanded="False">
                        <DataGrid ItemsSource="{Binding ProcessMetrics}" Height="176">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tiến trình" Binding="{Binding ProcessId}" />
                                <DataGridTextColumn Header="Hoàn thành" Binding="{Binding CompletionTime}" />
                                <DataGridTextColumn Header="Quay vòng" Binding="{Binding TurnaroundTime}" />
                                <DataGridTextColumn Header="Chờ" Binding="{Binding WaitingTime}" />
                                <DataGridTextColumn Header="Đáp ứng" Binding="{Binding ResponseTime}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </Grid>
            </Grid>

            <Expander Grid.Row="7" Header="Nhật ký sự kiện" IsExpanded="False" Margin="5">
                <ListBox ItemsSource="{Binding Events}" DisplayMemberPath="Description" Height="96" />
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>

