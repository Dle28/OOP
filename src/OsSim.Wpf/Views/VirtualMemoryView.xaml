<UserControl x:Class="OsSim.Wpf.Views.VirtualMemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OsSim.Wpf.Views"
             xmlns:animations="clr-namespace:OsSim.Wpf.Animations">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,2,4,5">
                <TextBlock Text="Bộ nhớ ảo" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Theo dõi kết quả TLB, bảng trang và thay trang."
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Expander Grid.Row="1" Header="Thiết lập kịch bản" IsExpanded="False" Margin="3">
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chuỗi địa chỉ ảo" FontWeight="SemiBold" />
                            <TextBlock Text="Thập phân hoặc 0x hex, phân tách bằng dấu phẩy hay khoảng trắng."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,4" />
                            <TextBox Text="{Binding AddressInput, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="54" MaxHeight="78" AcceptsReturn="True" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="Số bit địa chỉ" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                    <TextBox Text="{Binding VirtualAddressBits, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Kích thước trang" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                    <TextBox Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Số frame" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                    <TextBox Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TLB (0 để tắt)" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                    <TextBox Text="{Binding TlbCapacity, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Chính sách thay trang" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                    <ComboBox ItemsSource="{Binding Algorithms}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding SelectedAlgorithm}" Width="190" />
                                </StackPanel>
                            </WrapPanel>
                            <Button Grid.Row="1" Content="Tạo mô phỏng" Command="{Binding CreateSimulationCommand}"
                                    HorizontalAlignment="Right" Margin="4,5,4,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Expander>

            <views:PlaybackControls Grid.Row="2" DataContext="{Binding Playback}" />

            <StackPanel Grid.Row="3">
                <ContentControl Content="{Binding CurrentAction}" />
                <Expander Header="Số liệu tổng hợp" IsExpanded="False" Margin="3,0,3,5">
                    <ItemsControl ItemsSource="{Binding MetricCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <GroupBox Grid.Row="4" Header="Chuỗi tham chiếu trang" Margin="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="3,0,3,5">
                        <TextBlock Text="{Binding ReferenceSequenceCaption}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="HIT" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"
                                       FontSize="10" Margin="8,0" />
                            <TextBlock Text="FAULT" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                       FontSize="10" Margin="8,0" />
                            <TextBlock Text="CHỜ" Foreground="{StaticResource MutedBrush}" FontWeight="Bold"
                                       FontSize="10" Margin="8,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ReferenceSequence}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="62" MinHeight="74" Padding="6,5" Margin="3" CornerRadius="8"
                                            ToolTip="{Binding Address}"
                                            RenderTransformOrigin="0.5,0.5"
                                            animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFault}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Position}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding VirtualPageNumber}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ResultLabel}" FontSize="10" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="5" Header="Luồng dịch địa chỉ" Margin="3">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding TranslationFlow}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="70" Padding="8,6" Margin="3" CornerRadius="9"
                                        RenderTransformOrigin="0.5,0.5"
                                        animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter Property="Background" Value="#EAF3F8" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                    <Setter Property="Background" Value="#F1F4F7" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="#E3F4F5" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StepLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" MinHeight="28"
                                                   TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <Border Grid.Row="6" Style="{StaticResource SurfaceCardStyle}" Padding="13,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding CurrentTranslation}" Margin="0,5,0,4"
                               FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding MetricsText}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="7" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Row="0" Grid.Column="0" Header="Frame RAM">
                    <ItemsControl ItemsSource="{Binding FrameCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="112" MinHeight="72" Padding="8,6" Margin="3" CornerRadius="9"
                                        RenderTransformOrigin="0.5,0.5"
                                        animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WasReplaced}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Index}" FontSize="10"
                                                   FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
                <GroupBox Grid.Row="0" Grid.Column="1" Header="Swap disk">
                    <StackPanel>
                        <TextBlock Text="{Binding SwapSummary}" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" Margin="2,0,2,5" />
                        <ItemsControl ItemsSource="{Binding SwapPages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WarningSoftBrush}"
                                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                            CornerRadius="7" Padding="6,4" Margin="2">
                                        <TextBlock Text="{Binding StringFormat=Trang {0}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Row="0" Grid.Column="2" Header="Bảng trang">
                    <DataGrid ItemsSource="{Binding PageTable}" MinHeight="140" MaxHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trang ảo" Binding="{Binding VirtualPageNumber}" Width="*" />
                            <DataGridTextColumn Header="Frame" Binding="{Binding FrameIndex}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Grid.Row="0" Grid.Column="3" Header="TLB · LRU">
                    <DataGrid ItemsSource="{Binding Tlb}" MinHeight="140" MaxHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VPN" Binding="{Binding VirtualPageNumber}" Width="*" />
                            <DataGridTextColumn Header="Frame" Binding="{Binding FrameIndex}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <Expander Grid.Row="1" Grid.ColumnSpan="4" Header="Nhật ký truy cập" IsExpanded="False">
                    <ListBox ItemsSource="{Binding Events}" DisplayMemberPath="Description" Height="96" />
                </Expander>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

