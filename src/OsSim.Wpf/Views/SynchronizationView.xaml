<UserControl x:Class="OsSim.Wpf.Views.SynchronizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OsSim.Wpf.Views"
             xmlns:animations="clr-namespace:OsSim.Wpf.Animations">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,2,4,5">
                <TextBlock Text="Đồng bộ tiến trình" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Quan sát actor, tài nguyên và deadlock theo từng bước."
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Expander Grid.Row="1" Header="Thiết lập kịch bản" IsExpanded="False" Margin="3">
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" VerticalAlignment="Bottom">
                            <StackPanel Width="230">
                                <TextBlock Text="Kịch bản" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <ComboBox ItemsSource="{Binding Scenarios}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedScenario}" />
                            </StackPanel>
                            <StackPanel Width="270" Visibility="{Binding DiningVisibility}">
                                <TextBlock Text="Cách lấy đũa" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <ComboBox ItemsSource="{Binding DiningModes}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedDiningMode}" />
                            </StackPanel>
                            <Button Content="Tạo mô phỏng" Command="{Binding CreateSimulationCommand}"
                                    VerticalAlignment="Bottom" Margin="8,4,4,4" />
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                            <StackPanel Visibility="{Binding ProducerConsumerVisibility}">
                                <TextBlock Text="Sức chứa buffer" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding BufferCapacity, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ProducerConsumerVisibility}">
                                <TextBlock Text="Số nhà sản xuất" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding ProducerCount, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ProducerConsumerVisibility}">
                                <TextBlock Text="Số người tiêu dùng" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding ConsumerCount, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ProducerConsumerVisibility}">
                                <TextBlock Text="Sản phẩm mỗi nhà sản xuất" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding ItemsPerProducer, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ProducerConsumerVisibility}">
                                <TextBlock Text="Sản phẩm mỗi người tiêu dùng" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding ItemsPerConsumer, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding DiningVisibility}">
                                <TextBlock Text="Số triết gia" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding PhilosopherCount, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding DiningVisibility}">
                                <TextBlock Text="Số bữa mỗi người" Foreground="{StaticResource MutedBrush}" Margin="4,0" />
                                <TextBox Text="{Binding MealsPerPhilosopher, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Expander>

            <views:PlaybackControls Grid.Row="2" DataContext="{Binding Playback}" />

            <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceSoftBrush}"
                            CornerRadius="7" Padding="9,5" Margin="0,0,12,0">
                        <TextBlock Text="{Binding StepText}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Actor:" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ReadyActors}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedActorId}" Width="190" />
                    </WrapPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="10,0" MaxWidth="240" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <ContentControl Content="{Binding CurrentAction}" />
                <Expander Header="Số liệu tổng hợp" IsExpanded="False" Margin="3,0,3,5">
                    <ItemsControl ItemsSource="{Binding MetricCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Actor ảo" Margin="5">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Actors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="176" Padding="8" Margin="3" CornerRadius="9"
                                            RenderTransformOrigin="0.5,0.5"
                                            animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDispatched}" Value="True">
                                                        <Setter Property="Background" Value="#E8F4F7" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Background" Value="#FFF4E7" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" />
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding State}"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Role}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,4" />
                                            <TextBlock Text="{Binding HeldResources}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WaitingFor}" Foreground="{StaticResource WarningBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding CompletedWorkLabel}"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Semaphore, mutex và tài nguyên" Margin="5">
                    <DataGrid ItemsSource="{Binding Resources}" MinHeight="180" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài nguyên" Binding="{Binding Id}" Width="1.2*" />
                            <DataGridTextColumn Header="Giá trị" Binding="{Binding Count}" Width="0.5*" />
                            <DataGridTextColumn Header="Đang giữ" Binding="{Binding OwnerActorId}" Width="1*" />
                            <DataGridTextColumn Header="Hàng đợi FIFO" Binding="{Binding WaitQueue}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <Grid Grid.Row="6" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Buffer hữu hạn">
                    <StackPanel>
                        <DockPanel Margin="4,0,4,6">
                            <TextBlock Text="{Binding BufferSummary}" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right" Text="Lấy trước → thêm sau"
                                       Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding BufferSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="132" MinHeight="48" Padding="7,5" Margin="2" CornerRadius="8"
                                            RenderTransformOrigin="0.5,0.5"
                                            animations:PulseAnimation.PulseVersion="{Binding PulseVersion}">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#F1F4F7" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                        <Setter Property="Background" Value="#EAF4FA" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PositionLabel}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding ContentLabel}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="Đồ thị chờ · RAG">
                    <StackPanel>
                        <TextBlock Text="{Binding WaitGraphSummary}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="3,0,3,5" />
                        <ItemsControl ItemsSource="{Binding WaitGraphEdges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="7" Padding="6,5"
                                                Background="{StaticResource SurfaceSoftBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                                            <TextBlock Text="{Binding FromLabel}" FontWeight="SemiBold"
                                                       TextAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="→" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllocation}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding EdgeLabel}" FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllocation}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="7" Padding="6,5"
                                                Background="{StaticResource SurfaceSoftBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                                            <TextBlock Text="{Binding ToLabel}" FontWeight="SemiBold"
                                                       TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="Chu trình deadlock">
                    <StackPanel>
                        <TextBlock Text="{Binding DeadlockSummary}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="3,0,3,5" />
                        <ItemsControl ItemsSource="{Binding DeadlockCycles}" />
                    </StackPanel>
                </GroupBox>
            </Grid>

            <Expander Grid.Row="7" Header="Nhật ký sự kiện" IsExpanded="False" Margin="3">
                <ListBox ItemsSource="{Binding Events}" DisplayMemberPath="Description" Height="92" />
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>

