<UserControl x:Class="OsSim.Wpf.Views.BankerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OsSim.Wpf.Views"
             xmlns:animations="clr-namespace:OsSim.Wpf.Animations">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,2,4,5">
                <TextBlock Text="Cấp phát tài nguyên · Banker" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Tính Need = Max − Allocation, dựng safe sequence và kiểm tra request trên trạng thái giả định."
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Expander Grid.Row="1" Header="Thiết lập kịch bản" IsExpanded="False" Margin="3">
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
    
                        <Grid Grid.Row="0" Grid.Column="0" Margin="2,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tài nguyên" FontWeight="SemiBold" />
                                <TextBlock Text="Tên cột trong các vector, ví dụ A, B, C, D."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,3" />
                                <TextBox Text="{Binding ResourceNamesInput, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock Text="Available" FontWeight="SemiBold" />
                                <TextBox Text="{Binding AvailableInput, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="Mã tiến trình theo thứ tự hàng" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ProcessIdsInput, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
    
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Allocation · mỗi dòng một tiến trình" FontWeight="SemiBold" />
                                <TextBox Text="{Binding AllocationMatrixInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="112" MaxHeight="145"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Max demand · cùng thứ tự dòng" FontWeight="SemiBold" />
                                <TextBox Text="{Binding MaxDemandMatrixInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="112" MaxHeight="145"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            </StackPanel>
                        </Grid>
    
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                            <Button DockPanel.Dock="Right" Content="Tạo mô phỏng" Command="{Binding CreateSimulationCommand}"
                                    Margin="4,2,2,2" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Expander>

            <views:PlaybackControls Grid.Row="2" DataContext="{Binding Playback}" />

            <StackPanel Grid.Row="3">
                <ContentControl Content="{Binding CurrentAction}" />
                <Expander Header="Số liệu tổng hợp" IsExpanded="False" Margin="3,0,3,5">
                    <ItemsControl ItemsSource="{Binding MetricCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Ma trận Banker" Margin="3">
                    <DataGrid ItemsSource="{Binding ProcessRows}" MinHeight="230" MaxHeight="370">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tiến trình" Binding="{Binding Id}" Width="0.8*" />
                            <DataGridTextColumn Header="Đang giữ · Allocation" Binding="{Binding AllocationText}" Width="1.5*" />
                            <DataGridTextColumn Header="Tối đa · Max" Binding="{Binding MaxText}" Width="1.5*" />
                            <DataGridTextColumn Header="Cần thêm · Need" Binding="{Binding NeedText}" Width="1.5*" />
                            <DataGridTextColumn Header="Finish" Binding="{Binding FinishLabel}" Width="0.65*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Đồ thị cấp phát tài nguyên · RAG" Margin="3">
                    <ContentControl Content="{Binding ResourceGraph}" />
                </GroupBox>
            </Grid>

            <Expander Grid.Row="5" Header="Kiểm tra request và nhật ký bước" IsExpanded="False" Margin="3">
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.1*" />
                      <ColumnDefinition Width="0.9*" />
                  </Grid.ColumnDefinitions>
                  <GroupBox Header="Thử request trên trạng thái đầu vào" Margin="3">
                      <Grid>
                          <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="110" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                              <TextBlock Text="Process" Foreground="{StaticResource MutedBrush}" />
                              <TextBox Text="{Binding RequestProcessId, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="8,0,0,0">
                              <TextBlock Text="Request vector" Foreground="{StaticResource MutedBrush}" />
                              <TextBox Text="{Binding RequestAmountsInput, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="Kiểm tra an toàn" Command="{Binding TestRequestCommand}"
                                  VerticalAlignment="Bottom" Margin="8,3,2,3" />
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding RequestStatus}"
                                     Margin="4,6,4,2" FontWeight="SemiBold" />
                          <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding RequestSafeSequence}"
                                     Foreground="{StaticResource AccentBrush}" Margin="4,1,4,2" />
                      </Grid>
                  </GroupBox>
  
                  <GroupBox Grid.Column="1" Header="Step trace" Margin="3">
                      <ListBox ItemsSource="{Binding Events}" DisplayMemberPath="Description" Height="130" />
                  </GroupBox>
                </Grid>
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>
