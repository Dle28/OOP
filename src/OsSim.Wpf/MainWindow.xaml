<Window x:Class="OsSim.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OsSim.Wpf.Views"
        xmlns:viewModels="clr-namespace:OsSim.Wpf.ViewModels"
        Title="OS Lab Studio · Mô phỏng hệ điều hành"
        Width="1360"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:CpuSchedulerViewModel}">
            <views:CpuSchedulerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SynchronizationViewModel}">
            <views:SynchronizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:VirtualMemoryViewModel}">
            <views:VirtualMemoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BankerViewModel}">
            <views:BankerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,20,16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryContainerBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="OS" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="OS LAB STUDIO" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="MÔ PHỎNG HỆ ĐIỀU HÀNH" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="12,0">
                    <TextBlock Text="PHÒNG THỰC HÀNH" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,8,9" />
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavigationButtonStyle}"
                                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="27" Height="27" CornerRadius="7"
                                                Background="{StaticResource NavigationBadgeBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Index}" Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="2" Margin="12" Padding="12,10" CornerRadius="10"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="SIMULATION MODE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="LOCAL" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </DockPanel>
                        <TextBlock Text="Thời gian ảo · không tạo tiến trình hệ điều hành"
                                   FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                    Padding="22,9">
                <DockPanel LastChildFill="True">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HỆ ĐIỀU HÀNH  ·  OPERATING SYSTEMS"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="WORKBENCH // MÔ PHỎNG TƯƠNG TÁC"
                                   FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceSoftBrush}"
                            CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="VIRTUAL CLOCK" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding ActiveViewModel}" />
        </Grid>
    </Grid>
</Window>
