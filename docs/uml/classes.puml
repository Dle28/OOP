@startuml
skinparam classAttributeIconSize 0
hide empty members

interface "ISimulationModule<TInput, TSnapshot>" as ISimulationModule {
  +Validate(input: TInput): ValidationResult
  +CreateSession(input: TInput): SimulationCreationResult<TSnapshot>
}
interface "ISimulationSession<TSnapshot>" as ISimulationSession {
  +CurrentSnapshot: TSnapshot
  +StepPosition: int
  +StepCount: int?
  +CanStepForward: bool
  +CanStepBackward: bool
  +StepForward(command?: SimulationCommand): SimulationStepResult<TSnapshot>
  +StepBackward(): SimulationStepResult<TSnapshot>
  +Reset(): SimulationStepResult<TSnapshot>
}
class "SimulationCreationResult<TSnapshot>" as CreationResult {
  +Session: ISimulationSession<TSnapshot>?
  +Errors: IReadOnlyList<SimulationError>
  +Succeeded: bool
}
class "SimulationStepResult<TSnapshot>" as StepResult {
  +Succeeded: bool
  +IsCompleted: bool
  +Snapshot: TSnapshot
  +Event: SimulationEvent?
  +Error: SimulationError?
}
class SimulationEvent {
  +Sequence: long
  +VirtualTime: decimal
  +Code: string
  +Description: string
  +ActorId: string?
}
class SimulationCommand {
  +ActorId: string?
  +AutomaticDispatch: bool
}
class "TimelineSimulationSession<TSnapshot>" as TimelineSession
class "ReplayableSimulationSession<TSnapshot>" as ReplaySession
class "SimulationFrame<TSnapshot>" as Frame

class CpuSchedulingModule
class CpuSchedulingInput {
  +ContextSwitchOverhead: decimal
}
class CpuSimulationSnapshot {
  +Time: decimal
  +ContextSwitchCount: int
  +ContextSwitchTime: decimal
  +DispatchingProcessId: string?
}
class GanttSegment {
  +Start: decimal
  +End: decimal
  +Kind: GanttSegmentKind
  +IsIdle: bool
  +IsContextSwitch: bool
}
enum GanttSegmentKind {
  Execution
  Idle
  ContextSwitch
}
class CpuMetrics {
  +ContextSwitchCount: int
  +ContextSwitchTime: decimal
}
interface ICpuSchedulingPolicy
class "CPU scheduling policies" as CpuPolicies
class SynchronizationModule
class SynchronizationInput
class SynchronizationSnapshot {
  +LastDispatchedActorId: string?
}
class WaitForEdge {
  +WaiterActorId: string
  +ResourceId: string
  +OwnerActorId: string?
}
class VirtualMemoryModule
class VirtualMemoryInput
class VirtualMemorySnapshot {
  +SwapPages: IReadOnlyList<ulong>
}
class MemoryMetrics {
  +SwapIns: int
  +SwapOuts: int
}
interface IPageReplacementPolicy
class "Page replacement policies" as PagePolicies
interface IBankerModule {
  +TestRequest(currentState: BankerInput, request: BankerResourceRequest): BankerRequestResult
}
class BankerModule
class BankerInput
class BankerProcessInput
class BankerResourceRequest
class BankerProcessSnapshot
class BankerSnapshot {
  +Work: IReadOnlyList<int>
  +SafeSequence: IReadOnlyList<string>
  +State: BankerRunState
}
enum BankerRunState {
  Running
  Safe
  Unsafe
}
class BankerRequestResult {
  +Succeeded: bool
  +Disposition: BankerRequestDisposition?
  +SafeSequence: IReadOnlyList<string>
  +AvailableAfterEvaluation: IReadOnlyList<int>
  +Errors: IReadOnlyList<SimulationError>
  +Message: string
}
enum BankerRequestDisposition {
  Granted
  WaitForResources
  WouldBeUnsafe
}
class SimulationCatalog

package "WPF presentation" {
  class MainWindow
  class MainWindowViewModel {
    +SelectedArea: SimulationArea
    +ActiveViewModel: ISimulationAreaViewModel
    +NavigateToCommand
    -NavigateTo(item: SimulationNavigationItem)
  }
  class SimulationNavigationItem {
    +Area: SimulationArea
    +Index: string
    +Title: string
    +Description: string
    +IsSelected: bool
  }
  enum SimulationArea {
    Cpu
    Synchronization
    Memory
    ResourceAllocation
  }
  interface ISimulationAreaViewModel {
    +Area: SimulationArea
  }
  class "PlaybackController<TSnapshot>" as PlaybackController {
    +CurrentStepPosition: int
    +StepCount: int?
    +CanSeek: bool
    +TimelineMaximum: int
    +TimelineLabel: string
    +IntervalMilliseconds: int
    +IntervalLabel: string
    -Seek(position: int)
  }
  class CpuSchedulerViewModel
  class SynchronizationViewModel
  class VirtualMemoryViewModel
  class BankerViewModel
  class CpuProcessVisual
  class GanttSegmentVisual
  class SynchronizationActorDisplay
  class SynchronizationResourceDisplay
  class BufferSlotVisual
  class MemoryFlowStageVisual
  class MetricCardVisual {
    +Label: string
    +Value: string
    +Detail: string
    +Tone: MetricTone
  }
  class SimulationActionVisual {
    +StepLabel: string
    +Title: string
    +Description: string
    +Explanation: string
    +Tone: MetricTone
    +PulseVersion: long
  }
  class SimulationActionNarrator {
    +Describe(area: SimulationArea, event?: SimulationEvent, isDeadlocked: bool = false): SimulationActionVisual
  }
  enum MetricTone {
    Primary
    Success
    Warning
    Danger
  }
  class MemoryReferenceVisual {
    +Position: int
    +Address: ulong
    +VirtualPageNumber: ulong
    +ResultLabel: string
    +IsCurrent: bool
  }
  class MemoryFrameVisual {
    +Index: int
    +PageLabel: string
    +StatusLabel: string
    +IsCurrent: bool
    +WasReplaced: bool
  }
  class WaitGraphEdgeVisual {
    +FromLabel: string
    +ToLabel: string
    +EdgeLabel: string
    +IsAllocation: bool
  }
  class BankerProcessVisual
  class BankerRagProjector <<static>> {
    +Project(snapshot?: BankerSnapshot): BankerRagGraphVisual
  }
  class BankerRagGraphVisual {
    +CanvasWidth: double
    +CanvasHeight: double
    +Summary: string
    +Nodes: IReadOnlyList<BankerRagNodeVisual>
    +Edges: IReadOnlyList<BankerGraphEdgeVisual>
  }
  class BankerRagNodeVisual {
    +Label: string
    +SubLabel: string
    +IsResource: bool
    +IsFinished: bool
    +Left: double
    +Top: double
    +PulseVersion: long
  }
  class BankerGraphEdgeVisual {
    +FromLabel: string
    +ToLabel: string
    +EdgeLabel: string
    +IsAllocation: bool
    +Start: Point
    +End: Point
    +ArrowPoints: PointCollection
  }
  class PulseAnimation <<attached property>> {
    +PulseVersion: long
  }
  class ProgressValueAnimation <<attached property>> {
    +TargetValue: double
  }
}

